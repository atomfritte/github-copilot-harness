{
  "mcpServers": {
    "exampleRemote": {
      "type": "http",
      "url": "https://mcp.example.com/mcp",
      "headers": { "Authorization": "Bearer ${EXAMPLE_MCP_TOKEN}" },
      "tools": ["*"]
    },
    "exampleLocal": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/mcp-server@1.2.3"],
      "env": { "EXAMPLE_API_KEY": "${EXAMPLE_API_KEY}" },
      "tools": ["search", "get_item"]
    }
  }
}
