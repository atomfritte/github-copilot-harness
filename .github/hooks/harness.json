{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/harness/session-start.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node .github/hooks/harness/on-prompt.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/harness/guard.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/harness/goal-verdict.mjs",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/harness/goal-stop.mjs",
        "cwd": ".",
        "timeoutSec": 900
      }
    ]
  }
}
